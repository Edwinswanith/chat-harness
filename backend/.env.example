GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AUTH_TOKENS={"local-demo-token":["demo","default"]}
SANDBOX_URL=http://127.0.0.1:8001
SANDBOX_TOKEN=local-sandbox-token
DATA_DIR=/tmp/ai-harness
# Optional production persistence. Leave unset for SQLite + local storage.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=chatbot-harness
MONGODB_DATABASE=chatbot_harness
# auto uses Mongo/R2 for the standard host runtime and keeps custom test data dirs local.
# Set local to force SQLite/filesystem or mongo to force MongoDB/R2.
PERSISTENCE_MODE=auto
R2_BUCKET=chatbot-harness
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

# Workspace processing batch size; 0 batches means continue until completion or Cancel.
WORKSPACE_MAX_STEPS=80
WORKSPACE_MAX_BATCHES=0
